{
  "name": "skills-workflow",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run releases && docusaurus start",
    "start:es": "npm run releases && docusaurus start --locale es",
    "start:pt": "npm run releases && docusaurus start --locale pt",
    "start:pt-br": "npm run releases && docusaurus start --locale pt-br",
    "start:search": "npm run releases && docusaurus build --locale en && docusaurus serve",
    "start:all": "npm run releases && docusaurus build && docusaurus serve",
    "build": "npm run releases && docusaurus build && npm run generate:llms",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "generate:de": "node scripts/generate-de-docs.mjs",
    "generate:llms": "node scripts/generate-llms-txt.mjs",
    "releases": "node scripts/fetch-releases.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/plugin-content-docs": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@mdx-js/react": "^3.1.1",
    "@types/react": "^19.2.14",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "docusaurus-lunr-search": "^3.6.0",
    "postcss": "^8.5.8",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-player": "^3.4.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "node-sql-parser": "^5.4.0"
  },
  "resolutions": {
    "webpack": "5.95.0",
    "webpackbar": "6.0.1"
  }
}
